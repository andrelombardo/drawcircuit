% DrawCircuit — coordinates in cm; SVG Y axis inverted.
\definecolor{dcColor0}{HTML}{171A20}
\definecolor{dcColor1}{HTML}{2463CB}
\definecolor{dcColor2}{HTML}{DF4949}
\begin{circuitikz}[european resistors, american inductors, american ports, line cap=round, line join=round]
\ctikzset{bipoles/length=1.4cm}
\draw[draw=dcColor0, line width=1.4226pt] (-4,4) -- (-4,1);
\draw[draw=dcColor0, line width=1.4226pt] (-4,-1) -- (-4,-4);
\draw[draw=dcColor0, line width=1.4226pt] (0,4) -- (0,2.95);
\draw[draw=dcColor0, line width=1.4226pt] (0,2.05) -- (0,1);
\draw[draw=dcColor0, line width=1.4226pt] (0,-1) -- (0,-2.05);
\draw[draw=dcColor0, line width=1.4226pt] (0,-2.95) -- (0,-4);
\draw[draw=dcColor0, line width=1.4226pt] (4,4) -- (4,1);
\draw[draw=dcColor0, line width=1.4226pt] (4,-1) -- (4,-4);
\draw[draw=dcColor0, line width=1.4226pt] (-4,4) -- (4,4);
\draw[draw=dcColor0, line width=1.4226pt] (-4,-4) -- (4,-4);
% Component: americanResistor
\draw[draw=dcColor0, line width=1.4226pt] (-4,1) to[R, american resistors, fill=white, name=dcComponent0] (-4,-1);
% Component: americanResistor
\draw[draw=dcColor0, line width=1.4226pt] (0,1) to[R, american resistors, fill=white, name=dcComponent1] (0,-1);
% Component: americanResistor
\draw[draw=dcColor0, line width=1.4226pt] (4,1) to[R, american resistors, fill=white, name=dcComponent2] (4,-1);
\fill[dcColor0] (0,4) circle (3.2009pt);
\fill[dcColor0] (0,-4) circle (3.2009pt);
\node[text=dcColor1, anchor=center, inner sep=0pt, rotate=0, font=\fontsize{15.649}{20.3437}\selectfont] at (-4,1.2) {$R_1$};
\node[text=dcColor1, anchor=center, inner sep=0pt, rotate=0, font=\fontsize{15.649}{20.3437}\selectfont] at (0,1.2) {$R_2$};
\node[text=dcColor1, anchor=center, inner sep=0pt, rotate=0, font=\fontsize{15.649}{20.3437}\selectfont] at (4,1.2) {$R_3$};
\node[text=dcColor2, anchor=center, inner sep=0pt, rotate=0, font=\fontsize{17.0717}{22.1931}\selectfont] at (0,4.6) {$A^{\prime\prime}$};
\node[text=dcColor2, anchor=center, inner sep=0pt, rotate=0, font=\fontsize{17.0717}{22.1931}\selectfont] at (0,-3.4) {$B^{\prime\prime}$};
% Electrical annotation: current
\draw[draw=dcColor2,line width=1.4226pt] (-3.6,3.25) -- (-3.6,1.75);
\draw[draw=dcColor2,line width=1.4226pt] (-3.6875,1.95) -- (-3.6,1.75) -- (-3.5125,1.95);
\node[text=dcColor1, anchor=center, inner sep=0pt, rotate=0, font=\fontsize{15.649}{20.3437}\selectfont] at (-3,2.5) {$i_1$};
% Electrical annotation: current
\draw[draw=dcColor2,line width=1.4226pt,line cap=round,line join=round] (0,2.95) -- (0,2.05);
\draw[draw=dcColor2,line width=1.4226pt,line cap=round,line join=round] (-0.1125,2.3) -- (0,2.05) -- (0.1125,2.3);
\node[text=dcColor1, anchor=center, inner sep=0pt, rotate=0, font=\fontsize{15.649}{20.3437}\selectfont] at (-0.6,2.5) {$i_2$};
% Electrical annotation: current
\draw[draw=dcColor2,line width=1.4226pt,line cap=round,line join=round] (0,-2.05) -- (0,-2.95);
\draw[draw=dcColor2,line width=1.4226pt,line cap=round,line join=round] (-0.1125,-2.7) -- (0,-2.95) -- (0.1125,-2.7);
\node[text=dcColor1, anchor=center, inner sep=0pt, rotate=0, font=\fontsize{15.649}{20.3437}\selectfont] at (-0.6,-2.5) {$i_4$};
% Electrical annotation: current
\draw[draw=dcColor2,line width=1.4226pt] (4.4,3.25) -- (4.4,1.75);
\draw[draw=dcColor2,line width=1.4226pt] (4.3125,1.95) -- (4.4,1.75) -- (4.4875,1.95);
\node[text=dcColor1, anchor=center, inner sep=0pt, rotate=0, font=\fontsize{15.649}{20.3437}\selectfont] at (5,2.5) {$i_3$};
% Electrical annotation: current
\draw[draw=dcColor2,line width=1.4226pt] (-2.75,4.4) -- (-1.25,4.4);
\draw[draw=dcColor2,line width=1.4226pt] (-1.45,4.3125) -- (-1.25,4.4) -- (-1.45,4.4875);
\node[text=dcColor1, anchor=center, inner sep=0pt, rotate=0, font=\fontsize{15.649}{20.3437}\selectfont] at (-2,5) {i};
\end{circuitikz}