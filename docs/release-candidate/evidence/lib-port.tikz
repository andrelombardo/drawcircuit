% DrawCircuit — coordinates in cm; SVG Y axis inverted.
\definecolor{dcColor0}{HTML}{171A20}
\definecolor{dcColor1}{HTML}{2463CB}
\begin{circuitikz}[european resistors, american inductors, american ports, line cap=round, line join=round]
\ctikzset{bipoles/length=1.4cm}
\draw[draw=dcColor0, line width=1.4226pt] (1,-1.5) -- (-1,-1.5) -- (-1,3) -- (-3.5,3);
% Component: port
% Single-connection diagram port outline.
\draw[draw=dcColor0, line width=1.4226pt] (1,-1.5) -- (1.5,-1.5);
\draw[draw=dcColor0, line width=1.4226pt, fill=white] (1.5,-1.2) -- (2.25,-1.2) -- (2.55,-1.5) -- (2.25,-1.8) -- (1.5,-1.8) -- cycle;
\node[text=dcColor1, anchor=center, inner sep=0pt, rotate=0, font=\fontsize{15.649}{20.3437}\selectfont] at (2,-0.3) {$q_{port}$};
\end{circuitikz}