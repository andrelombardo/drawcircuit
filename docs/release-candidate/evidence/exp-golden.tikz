\node[text=dcColor2, anchor=center, inner sep=0pt, rotate=0, font=\fontsize{16.3603}{21.2684}\selectfont] at (-3,2.5) {$i_1$};
% Electrical annotation: current
\draw[draw=dcColor2,line width=1.4226pt] (4.25,0.4) -- (5.75,0.4);
\draw[draw=dcColor2,line width=1.4226pt] (5.55,0.3125) -- (5.75,0.4) -- (5.55,0.4875);
\node[text=dcColor1, anchor=center, inner sep=0pt, rotate=0, font=\fontsize{15.649}{20.3437}\selectfont] at (5,1) {$i_1$};
% Electrical annotation: voltage
\draw[draw=dcColor2,line width=1.4226pt] (11,-1.5) -- (11,-5.5);
\draw[draw=dcColor2,line width=1.4226pt] (10.9125,-5.3) -- (11,-5.5) -- (11.0875,-5.3);
\node[text=dcColor1, anchor=center, inner sep=0pt, rotate=0, font=\fontsize{15.649}{20.3437}\selectfont] at (11.6,-3.5) {$V_{AB}$};
