\node[text=dcColor1, anchor=center, inner sep=0pt, rotate=0, font=\fontsize{16.3603}{21.2684}\selectfont] at (7.1,-3) {$r_{CD}$};
\node[text=dcColor1, anchor=center, inner sep=0pt, rotate=0, font=\fontsize{15.649}{20.3437}\selectfont] at (-11.5,5.75) {$50 \Omega$};
\node[text=dcColor1, anchor=center, inner sep=0pt, rotate=0, font=\fontsize{15.649}{20.3437}\selectfont] at (-11.5,2.25) {$R_2$};
\node[text=dcColor1, anchor=center, inner sep=0pt, rotate=0, font=\fontsize{15.649}{20.3437}\selectfont] at (-11.5,-1.25) {$C_1$};
\node[text=dcColor1, anchor=center, inner sep=0pt, rotate=0, font=\fontsize{15.649}{20.3437}\selectfont] at (-11.5,-4.75) {$L_1$};
\node[text=dcColor1, anchor=center, inner sep=0pt, rotate=0, font=\fontsize{15.649}{20.3437}\selectfont] at (10,5.75) {$V_1$};
\node[text=dcColor1, anchor=center, inner sep=0pt, rotate=0, font=\fontsize{15.649}{20.3437}\selectfont] at (10,1.75) {$I_1$};
\node[text=dcColor2, anchor=center, inner sep=0pt, rotate=0, font=\fontsize{19.2056}{24.9673}\selectfont] at (-6.65,-0.125) {A};
\node[text=dcColor2, anchor=center, inner sep=0pt, rotate=0, font=\fontsize{19.2056}{24.9673}\selectfont] at (0,0.75) {B};
