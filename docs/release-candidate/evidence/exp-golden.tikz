% DrawCircuit — coordinates in cm; SVG Y axis inverted.
\definecolor{dcColor0}{HTML}{171A20}
\definecolor{dcColor1}{HTML}{2463CB}
\definecolor{dcColor2}{HTML}{DF4949}
\begin{circuitikz}[european resistors, american inductors, american ports, line cap=round, line join=round]
\ctikzset{bipoles/length=1.4cm}
\draw[draw=dcColor0, line width=1.4226pt] (-4,0) -- (-6,0);
\draw[draw=dcColor0, line width=1.4226pt] (-2,0) -- (0,0);
\draw[draw=dcColor0, line width=1.4226pt] (2,0) -- (0,0);
\draw[draw=dcColor0, line width=1.4226pt] (4,0) -- (6,0);
\draw[draw=dcColor0, line width=1.4226pt] (-6,-2) -- (-6,0);
\draw[draw=dcColor0, line width=1.4226pt] (-6,-4) -- (-6,-5.5) -- (0,-5.5);
\draw[draw=dcColor0, line width=1.4226pt] (0,-2) -- (0,0);
\draw[draw=dcColor0, line width=1.4226pt] (0,-4) -- (0,-5.5);
\draw[draw=dcColor0, line width=1.4226pt] (6,-2) -- (6,0);
\draw[draw=dcColor0, line width=1.4226pt] (6,-4) -- (6,-5.5) -- (0,-5.5);
\draw[draw=dcColor0, line width=1.4226pt] (-1,4) -- (-6,4) -- (-6,0);
\draw[draw=dcColor0, line width=1.4226pt] (1,4) -- (6,4) -- (6,0);
\draw[draw=dcColor0, line width=1.4226pt] (-10,-7.5) -- (-3.5,-7.5);
\draw[draw=dcColor0, line width=1.4226pt] (-7,-6) -- (-7,-9);
% Unconnected wire crossing: horizontal bridge
\draw[draw=white,line width=4.2679pt] (-7.175,-7.5) -- (-6.825,-7.5);
\draw[draw=dcColor0,line width=1.4226pt] (-7,-7.325) -- (-7,-7.675);
\draw[draw=white,line width=4.2679pt] (-7.175,-7.5) .. controls (-7.105,-7.325) and (-6.895,-7.325) .. (-6.825,-7.5);
\draw[draw=dcColor0,line width=1.4226pt] (-7.175,-7.5) .. controls (-7.105,-7.325) and (-6.895,-7.325) .. (-6.825,-7.5);
% Component: resistor
\draw[draw=dcColor0, line width=1.4226pt] (-4,0) to[R, fill=white, name=dcComponent0] (-2,0);
% Component: resistor
\draw[draw=dcColor0, line width=1.4226pt] (2,0) to[R, fill=white, name=dcComponent1] (4,0);
% Component: resistor
\draw[draw=dcColor0, line width=1.4226pt] (-1,4) to[R, fill=white, name=dcComponent2] (1,4);
% Component: resistor
\draw[draw=dcColor0, line width=1.4226pt] (-6,-2) to[R, fill=white, name=dcComponent3] (-6,-4);
% Component: resistor
\draw[draw=dcColor0, line width=1.4226pt] (0,-2) to[R, fill=white, name=dcComponent4] (0,-4);
% Component: resistor
\draw[draw=dcColor0, line width=1.4226pt] (6,-2) to[R, fill=white, name=dcComponent5] (6,-4);
% Component: resistor
\draw[draw=dcColor0, line width=1.4226pt] (-12.5,5) to[R, fill=white, name=dcComponent6] (-10.5,5);
% Component: resistor
\draw[draw=dcColor0, line width=1.4226pt] (-12.5,1.5) to[R, fill=white, name=dcComponent7] (-10.5,1.5);
% Component: capacitor
\draw[draw=dcColor0, line width=1.4226pt] (-12.5,-2) to[C, fill=white, name=dcComponent8] (-10.5,-2);
% Component: inductor
\draw[draw=dcColor0, line width=1.4226pt] (-12.5,-5.5) to[L, fill=white, name=dcComponent9] (-10.5,-5.5);
% Component: voltageSource
\draw[draw=dcColor0, line width=1.4226pt] (9,5) to[american voltage source, fill=white, name=dcComponent10] (11,5);
% Component: currentSource
\draw[draw=dcColor0, line width=1.4226pt] (9,1) to[american current source, fill=white, name=dcComponent11] (11,1);
\fill[dcColor0] (-6,0) circle (3.2009pt);
\fill[dcColor0] (0,0) circle (3.2009pt);
\fill[dcColor0] (6,0) circle (3.2009pt);
\fill[dcColor0] (0,-5.5) circle (3.2009pt);
\node[text=dcColor1, anchor=center, inner sep=0pt, rotate=0, font=\fontsize{16.3603}{21.2684}\selectfont] at (-3,0.75) {$r_{AB}$};
\node[text=dcColor1, anchor=center, inner sep=0pt, rotate=0, font=\fontsize{16.3603}{21.2684}\selectfont] at (3,0.75) {$r_{BC}$};
