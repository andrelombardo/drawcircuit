% DrawCircuit — coordinates in cm; SVG Y axis inverted.
\definecolor{dcColor0}{HTML}{171A20}
\definecolor{dcColor1}{HTML}{2463CB}
\definecolor{dcColor2}{HTML}{DF4949}
\begin{circuitikz}[european resistors, american inductors, american ports, line cap=round, line join=round]
\ctikzset{bipoles/length=1.4cm}
\draw[draw=dcColor0, line width=1.4226pt] (1,3.5) -- (-0.5,3.5) -- (-0.5,2.5) -- (-3,2.5) -- (-3,3.5) -- (-3,0.5);
\draw[draw=dcColor0, line width=1.4226pt] (-3,-1.5) -- (-3,-4.5) -- (1,-4.5);
\draw[draw=dcColor0, line width=1.4226pt] (1,3.5) -- (5,3.5) -- (5,0.5);
\draw[draw=dcColor0, line width=1.4226pt] (5,-1.5) -- (5,-4.5) -- (1,-4.5);
% Component: currentSource
\draw[draw=dcColor0, line width=1.4226pt] (-3,0.5) to[american current source, fill=white, name=dcComponent0] (-3,-1.5);
% Component: resistor
\draw[draw=dcColor0, line width=1.4226pt] (5,0.5) to[R, fill=white, name=dcComponent1] (5,-1.5);
\fill[dcColor0] (1,3.5) circle (3.2009pt);
\fill[dcColor0] (1,-4.5) circle (3.2009pt);
\node[text=dcColor1, anchor=center, inner sep=0pt, rotate=0, font=\fontsize{15.649}{20.3437}\selectfont] at (-4.5,-0.5) {$I_s$};
\node[text=dcColor1, anchor=center, inner sep=0pt, rotate=0, font=\fontsize{15.649}{20.3437}\selectfont] at (6.5,-0.5) {$R_s$};
\node[text=dcColor2, anchor=center, inner sep=0pt, rotate=0, font=\fontsize{17.0717}{22.1931}\selectfont] at (1,4.1) {A};
\node[text=dcColor2, anchor=center, inner sep=0pt, rotate=0, font=\fontsize{17.0717}{22.1931}\selectfont] at (1,-5.5) {B};
\end{circuitikz}