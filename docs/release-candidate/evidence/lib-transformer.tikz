\draw[draw=dcColor0, line width=1.4226pt] (1.925,-0.875) -- (1.925,-2.125) (2.075,-0.875) -- (2.075,-2.125);
\node[text=dcColor1, anchor=center, inner sep=0pt, rotate=0, font=\fontsize{15.649}{20.3437}\selectfont] at (2,0) {$q_{transformer}$};
