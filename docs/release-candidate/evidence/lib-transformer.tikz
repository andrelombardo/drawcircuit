\ctikzset{bipoles/length=1.4cm}
\draw[draw=dcColor0, line width=1.4226pt] (1,-0.5) -- (-1,-0.5) -- (-1,3) -- (-3.5,3);
\draw[draw=dcColor0, line width=1.4226pt] (1,-2.5) -- (-1,-2.5) -- (-1,2) -- (-3.5,2);
\draw[draw=dcColor0, line width=1.4226pt] (3,-0.5) -- (4.5,-0.5) -- (4.5,1) -- (6,1);
