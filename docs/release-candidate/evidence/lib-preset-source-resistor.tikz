% DrawCircuit — coordinates in cm; SVG Y axis inverted.
\definecolor{dcColor0}{HTML}{171A20}
\definecolor{dcColor1}{HTML}{2463CB}
\begin{circuitikz}[european resistors, american inductors, american ports, line cap=round, line join=round]
\ctikzset{bipoles/length=1.4cm}
\draw[draw=dcColor0, line width=1.4226pt] (-3,0.5) -- (-3,2.5) -- (-1,2.5) -- (-1,1.5) -- (-1,2.5) -- (0,2.5);
\draw[draw=dcColor0, line width=1.4226pt] (2,2.5) -- (5,2.5) -- (5,-3.5) -- (-3,-3.5) -- (-3,-1.5);
% Component: voltageSource
\draw[draw=dcColor0, line width=1.4226pt] (-3,0.5) to[american voltage source, fill=white, name=dcComponent0] (-3,-1.5);
% Component: resistor
\draw[draw=dcColor0, line width=1.4226pt] (0,2.5) to[R, fill=white, name=dcComponent1] (2,2.5);
\node[text=dcColor1, anchor=center, inner sep=0pt, rotate=0, font=\fontsize{15.649}{20.3437}\selectfont] at (-4.5,-0.5) {$V_1$};
\node[text=dcColor1, anchor=center, inner sep=0pt, rotate=0, font=\fontsize{15.649}{20.3437}\selectfont] at (1,3.25) {$R_1$};
\end{circuitikz}