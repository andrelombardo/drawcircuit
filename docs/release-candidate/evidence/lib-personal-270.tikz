% DrawCircuit — coordinates in cm; SVG Y axis inverted.
\definecolor{dcColor0}{HTML}{171A20}
\definecolor{dcColor1}{HTML}{2463CB}
\begin{circuitikz}[european resistors, american inductors, american ports, line cap=round, line join=round]
\ctikzset{bipoles/length=1.4cm}
\draw[draw=dcColor0, line width=1.4226pt] (3.19,2.0362) -- (1.19,2.0362) -- (2.19,2.0362) -- (2.19,4.0362) -- (1.19,4.0362) -- (1.19,5.0362);
\draw[draw=dcColor0, line width=1.4226pt] (1.19,7.0362) -- (1.19,10.0362) -- (3.19,10.0362);
\draw[draw=dcColor0, line width=1.4226pt] (5.19,10.0362) -- (7.19,10.0362) -- (7.19,2.0362) -- (5.19,2.0362);
% Component: voltageSource
\draw[draw=dcColor0, line width=1.4226pt] (3.19,2.0362) to[american voltage source, fill=white, name=dcComponent0] (5.19,2.0362);
% Component: resistor
\draw[draw=dcColor0, line width=1.4226pt] (1.19,5.0362) to[R, fill=white, name=dcComponent1] (1.19,7.0362);
% Component: blackBox
\draw[draw=dcColor0, line width=1.4226pt] (3.19,10.0362) to[generic, fill=white, name=dcComponent2] (5.19,10.0362);
\node[text=dcColor1, anchor=center, inner sep=0pt, rotate=0, font=\fontsize{15.649}{20.3437}\selectfont] at (4.19,0.5362) {$V_s$};
\node[text=dcColor1, anchor=center, inner sep=0pt, rotate=0, font=\fontsize{15.649}{20.3437}\selectfont] at (0.44,6.0362) {$R_s$};
\node[text=dcColor1, anchor=center, inner sep=0pt, rotate=0, font=\fontsize{15.649}{20.3437}\selectfont] at (4.19,11.5362) {LOAD};
\end{circuitikz}