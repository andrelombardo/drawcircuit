% DrawCircuit — coordinates in cm; SVG Y axis inverted.
\definecolor{dcColor0}{HTML}{171A20}
\begin{circuitikz}[european resistors, american inductors, american ports, line cap=round, line join=round]
\ctikzset{bipoles/length=1.4cm}
\draw[draw=dcColor0, line width=1.4226pt] (0,-1.5) -- (6.5,-1.5);
\draw[draw=dcColor0, line width=1.4226pt] (3,0) -- (3,-3);
% Unconnected wire crossing: horizontal bridge
\draw[draw=white,line width=4.2679pt] (2.825,-1.5) -- (3.175,-1.5);
\draw[draw=dcColor0,line width=1.4226pt] (3,-1.325) -- (3,-1.675);
\draw[draw=white,line width=4.2679pt] (2.825,-1.5) .. controls (2.895,-1.325) and (3.105,-1.325) .. (3.175,-1.5);
\draw[draw=dcColor0,line width=1.4226pt] (2.825,-1.5) .. controls (2.895,-1.325) and (3.105,-1.325) .. (3.175,-1.5);
\end{circuitikz}