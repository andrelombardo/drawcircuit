% DrawCircuit — coordinates in cm; SVG Y axis inverted.
\definecolor{dcColor0}{HTML}{171A20}
\definecolor{dcColor1}{HTML}{2463CB}
\definecolor{dcColor2}{HTML}{DF4949}
\begin{circuitikz}[european resistors, american inductors, american ports, line cap=round, line join=round]
\ctikzset{bipoles/length=1.4cm}
\draw[draw=dcColor0, line width=1.4226pt] (-4.5,1.5) -- (-4.5,2.5);
\draw[draw=dcColor0, line width=1.4226pt] (-4.5,2.5) -- (-3,2.5);
\draw[draw=dcColor0, line width=1.4226pt] (-1,2.5) -- (-0.5,2.5);
\draw[draw=dcColor0, line width=1.4226pt] (-0.5,2.5) -- (0,2.5);
\draw[draw=dcColor0, line width=1.4226pt] (2,2.5) -- (3,2.5);
\draw[draw=dcColor0, line width=1.4226pt] (3,2.5) -- (3,1.5);
\draw[draw=dcColor0, line width=1.4226pt] (3,-0.5) -- (3,-1.5) -- (0.5,-1.5);
\draw[draw=dcColor0, line width=1.4226pt] (-1.5,-1.5) -- (-4.5,-1.5);
\draw[draw=dcColor0, line width=1.4226pt] (-4.5,-1.5) -- (-4.5,-0.5);
% Component: voltageSource
\draw[draw=dcColor0, line width=1.4226pt] (-4.5,1.5) to[american voltage source, fill=white, name=dcComponent0] (-4.5,-0.5);
% Component: resistor
\draw[draw=dcColor0, line width=1.4226pt] (-3,2.5) to[R, fill=white, name=dcComponent1] (-1,2.5);
% Component: resistor
\draw[draw=dcColor0, line width=1.4226pt] (0,2.5) to[R, fill=white, name=dcComponent2] (2,2.5);
% Component: resistor
\draw[draw=dcColor0, line width=1.4226pt] (3,1.5) to[R, fill=white, name=dcComponent3] (3,-0.5);
% Component: resistor
\draw[draw=dcColor0, line width=1.4226pt] (0.5,-1.5) to[R, fill=white, name=dcComponent4] (-1.5,-1.5);
\fill[dcColor0] (-4.5,2.5) circle (3.2009pt);
\fill[dcColor0] (-0.5,2.5) circle (3.2009pt);
\fill[dcColor0] (3,2.5) circle (3.2009pt);
\fill[dcColor0] (-4.5,-1.5) circle (3.2009pt);
\node[text=dcColor1, anchor=center, inner sep=0pt, rotate=0, font=\fontsize{15.649}{20.3437}\selectfont] at (-3.75,0.5) {$V_1$};
\node[text=dcColor1, anchor=center, inner sep=0pt, rotate=0, font=\fontsize{15.649}{20.3437}\selectfont] at (-2,3.25) {$r_{AB}$};
\node[text=dcColor1, anchor=center, inner sep=0pt, rotate=0, font=\fontsize{15.649}{20.3437}\selectfont] at (1,3.25) {$R_2$};
\node[text=dcColor1, anchor=center, inner sep=0pt, rotate=0, font=\fontsize{15.649}{20.3437}\selectfont] at (3.75,0.5) {$R_3$};
\node[text=dcColor1, anchor=center, inner sep=0pt, rotate=0, font=\fontsize{15.649}{20.3437}\selectfont] at (-0.5,-2.25) {$R_4$};
\node[text=dcColor2, anchor=center, inner sep=0pt, rotate=0, font=\fontsize{17.0717}{22.1931}\selectfont] at (-4.5,3.1) {A};
\node[text=dcColor2, anchor=center, inner sep=0pt, rotate=0, font=\fontsize{17.0717}{22.1931}\selectfont] at (-0.5,3.1) {B};
\node[text=dcColor2, anchor=center, inner sep=0pt, rotate=0, font=\fontsize{17.0717}{22.1931}\selectfont] at (3,3.1) {C};
\node[text=dcColor2, anchor=center, inner sep=0pt, rotate=0, font=\fontsize{17.0717}{22.1931}\selectfont] at (-4.5,-0.9) {D};
% Electrical annotation: current
\draw[draw=dcColor2,line width=1.4226pt] (-4.5,2.9) -- (-3,2.9);
\draw[draw=dcColor2,line width=1.4226pt] (-3.2,2.8125) -- (-3,2.9) -- (-3.2,2.9875);
\node[text=dcColor1, anchor=center, inner sep=0pt, rotate=0, font=\fontsize{15.649}{20.3437}\selectfont] at (-3.75,3.5) {$i_1$};
\draw[->, draw=dcColor2, line width=1.4226pt] (0.9785,0.6564) arc[start angle=369, end angle=45, x radius=1.75cm, y radius=1cm];
\node[text=dcColor2, anchor=west, inner sep=0pt, rotate=0, font=\fontsize{17.0717}{22.1931}\selectfont] at (-1,0.5) {maglia 1};
% Electrical annotation: voltage
\draw[draw=dcColor2,line width=1.4226pt] (-5.5,2.5) -- (-5.5,-1.5);
\draw[draw=dcColor2,line width=1.4226pt] (-5.5875,-1.3) -- (-5.5,-1.5) -- (-5.4125,-1.3);
\node[text=dcColor1, anchor=center, inner sep=0pt, rotate=0, font=\fontsize{15.649}{20.3437}\selectfont] at (-4.9,0.5) {$V_{AB}$};
\end{circuitikz}