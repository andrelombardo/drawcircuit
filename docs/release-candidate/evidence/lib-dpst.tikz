% DrawCircuit — coordinates in cm; SVG Y axis inverted.
\definecolor{dcColor0}{HTML}{171A20}
\definecolor{dcColor1}{HTML}{2463CB}
\begin{circuitikz}[european resistors, american inductors, american ports, line cap=round, line join=round]
\ctikzset{bipoles/length=1.4cm}
\draw[draw=dcColor0, line width=1.4226pt] (1,-1) -- (-1,-1) -- (-1,3) -- (-3.5,3);
\draw[draw=dcColor0, line width=1.4226pt] (3,-1) -- (4.5,-1) -- (4.5,2) -- (6,2);
\draw[draw=dcColor0, line width=1.4226pt] (1,-2) -- (-1,-2) -- (-1,1) -- (-3.5,1);
\draw[draw=dcColor0, line width=1.4226pt] (3,-2) -- (4.5,-2) -- (4.5,0) -- (6,0);
% Component: dpst
% Mechanically linked DPST contacts: no reliable native equivalent.
\draw[draw=dcColor0, line width=1.4226pt] (1,-1) -- (1.575,-1) (2.425,-1) -- (3,-1) (1.625,-1) -- (2.325,-0.525);
\draw[draw=dcColor0, line width=1.4226pt, fill=white] (1.6,-1) circle (1.7783pt);
\draw[draw=dcColor0, line width=1.4226pt, fill=white] (2.4,-1) circle (1.7783pt);
\draw[draw=dcColor0, line width=1.4226pt] (1,-2) -- (1.575,-2) (2.425,-2) -- (3,-2) (1.625,-2) -- (2.325,-1.525);
\draw[draw=dcColor0, line width=1.4226pt, fill=white] (1.6,-2) circle (1.7783pt);
\draw[draw=dcColor0, line width=1.4226pt, fill=white] (2.4,-2) circle (1.7783pt);
\draw[draw=dcColor0, line width=1.4226pt, densely dashed] (2,-0.825) -- (2,-1.825);
\node[text=dcColor1, anchor=center, inner sep=0pt, rotate=0, font=\fontsize{15.649}{20.3437}\selectfont] at (2,-0.3) {$q_{dpst}$};
\end{circuitikz}