% DrawCircuit — coordinates in cm; SVG Y axis inverted.
\definecolor{dcColor0}{HTML}{171A20}
\definecolor{dcColor1}{HTML}{2463CB}
\begin{circuitikz}[european resistors, american inductors, american ports, line cap=round, line join=round]
\ctikzset{bipoles/length=1.4cm}
\draw[draw=dcColor0, line width=1.4226pt] (1,-1) -- (-1,-1) -- (-1,3) -- (-3.5,3);
\draw[draw=dcColor0, line width=1.4226pt] (1,-2) -- (-1,-2) -- (-1,2) -- (-3.5,2);
% Component: connector2
% Connector socket with two exact, independent pins.
\draw[draw=dcColor0, line width=1.4226pt, fill=white] (1.55,-0.75) -- (2.45,-0.75) -- (2.45,-2.25) -- (1.55,-2.25) -- cycle;
\draw[draw=dcColor0, line width=1.4226pt] (1,-1) -- (1.875,-1);
\draw[draw=dcColor0, line width=1.4226pt, fill=white] (1.925,-1) circle (2.134pt);
\draw[draw=dcColor0, line width=1.4226pt] (1,-2) -- (1.875,-2);
\draw[draw=dcColor0, line width=1.4226pt, fill=white] (1.925,-2) circle (2.134pt);
\node[text=dcColor1, anchor=center, inner sep=0pt, rotate=0, font=\fontsize{15.649}{20.3437}\selectfont] at (2,-0.3) {$q_{connector2}$};
\end{circuitikz}