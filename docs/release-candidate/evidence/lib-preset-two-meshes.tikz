% DrawCircuit — coordinates in cm; SVG Y axis inverted.
\definecolor{dcColor0}{HTML}{171A20}
\definecolor{dcColor1}{HTML}{2463CB}
\begin{circuitikz}[european resistors, american inductors, american ports, line cap=round, line join=round]
\ctikzset{bipoles/length=1.4cm}
\draw[draw=dcColor0, line width=1.4226pt] (-5,0.5) -- (-4.5,0.5) -- (-5,0.5) -- (-5,2.5) -- (-3,2.5);
\draw[draw=dcColor0, line width=1.4226pt] (-1,2.5) -- (1,2.5);
\draw[draw=dcColor0, line width=1.4226pt] (1,2.5) -- (3,2.5);
\draw[draw=dcColor0, line width=1.4226pt] (5,2.5) -- (7,2.5) -- (7,0.5);
\draw[draw=dcColor0, line width=1.4226pt] (-5,-1.5) -- (-5,-3.5) -- (1,-3.5);
\draw[draw=dcColor0, line width=1.4226pt] (7,-1.5) -- (7,-3.5) -- (1,-3.5);
\draw[draw=dcColor0, line width=1.4226pt] (1,2.5) -- (1,0.5);
\draw[draw=dcColor0, line width=1.4226pt] (1,-1.5) -- (1,-3.5);
% Component: resistor
\draw[draw=dcColor0, line width=1.4226pt] (-3,2.5) to[R, fill=white, name=dcComponent0] (-1,2.5);
% Component: resistor
\draw[draw=dcColor0, line width=1.4226pt] (3,2.5) to[R, fill=white, name=dcComponent1] (5,2.5);
% Component: resistor
\draw[draw=dcColor0, line width=1.4226pt] (1,0.5) to[R, fill=white, name=dcComponent2] (1,-1.5);
% Component: voltageSource
\draw[draw=dcColor0, line width=1.4226pt] (-5,0.5) to[american voltage source, fill=white, name=dcComponent3] (-5,-1.5);
% Component: voltageSource
\draw[draw=dcColor0, line width=1.4226pt] (7,0.5) to[american voltage source, fill=white, name=dcComponent4] (7,-1.5);
\fill[dcColor0] (1,2.5) circle (3.2009pt);
\fill[dcColor0] (1,-3.5) circle (3.2009pt);
\node[text=dcColor1, anchor=center, inner sep=0pt, rotate=0, font=\fontsize{15.649}{20.3437}\selectfont] at (-2,3.25) {$R_1$};
\node[text=dcColor1, anchor=center, inner sep=0pt, rotate=0, font=\fontsize{15.649}{20.3437}\selectfont] at (4,3.25) {$R_2$};
\node[text=dcColor1, anchor=center, inner sep=0pt, rotate=0, font=\fontsize{15.649}{20.3437}\selectfont] at (2,-0.5) {$R_3$};
\node[text=dcColor1, anchor=center, inner sep=0pt, rotate=0, font=\fontsize{15.649}{20.3437}\selectfont] at (-6.5,-0.5) {$V_1$};
\node[text=dcColor1, anchor=center, inner sep=0pt, rotate=0, font=\fontsize{15.649}{20.3437}\selectfont] at (8.5,-0.5) {$V_2$};
\end{circuitikz}