% Component: npn
\node[npn, draw=dcColor0, line width=1.4226pt, fill=white, rotate=0, scale=0.7, transform shape] (dcComponent0) at (-5.5,1) {};
\draw[draw=dcColor0, line width=1.4226pt] (-6.5,1) -- (dcComponent0.B);
\draw[draw=dcColor0, line width=1.4226pt] (-5,2) -- (dcComponent0.C);
\draw[draw=dcColor0, line width=1.4226pt] (-5,0) -- (dcComponent0.E);
% Component: opAmp
\node[op amp, draw=dcColor0, line width=1.4226pt, fill=white, rotate=0, scale=0.6, transform shape] (dcComponent1) at (3.5,1) {};
\draw[draw=dcColor0, line width=1.4226pt] (2.5,1.5) -- (dcComponent1.-);
\draw[draw=dcColor0, line width=1.4226pt] (2.5,0.5) -- (dcComponent1.+);
\draw[draw=dcColor0, line width=1.4226pt] (4.5,1) -- (dcComponent1.out);
% Component: npn
\node[npn, draw=dcColor0, line width=1.4226pt, fill=white, rotate=0, scale=0.7, transform shape] (dcComponent2) at (13,-3.65) {};
\draw[draw=dcColor0, line width=1.4226pt] (12,-3.65) -- (dcComponent2.B);
