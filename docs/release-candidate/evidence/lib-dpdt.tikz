% DrawCircuit — coordinates in cm; SVG Y axis inverted.
\definecolor{dcColor0}{HTML}{171A20}
\definecolor{dcColor1}{HTML}{2463CB}
\begin{circuitikz}[european resistors, american inductors, american ports, line cap=round, line join=round]
\ctikzset{bipoles/length=1.4cm}
\draw[draw=dcColor0, line width=1.4226pt] (1,-0.75) -- (-1,-0.75) -- (-1,3) -- (-3.5,3);
\draw[draw=dcColor0, line width=1.4226pt] (3,-0.25) -- (4.5,-0.25) -- (4.5,2) -- (6,2);
\draw[draw=dcColor0, line width=1.4226pt] (3,-1.25) -- (4.5,-1.25) -- (4.5,1) -- (6,1);
\draw[draw=dcColor0, line width=1.4226pt] (1,-2.25) -- (-1,-2.25) -- (-1,0) -- (-3.5,0);
\draw[draw=dcColor0, line width=1.4226pt] (3,-1.75) -- (4.5,-1.75) -- (4.5,-1) -- (6,-1);
\draw[draw=dcColor0, line width=1.4226pt] (3,-2.75) -- (4.5,-2.75) -- (4.5,-2) -- (6,-2);
% Component: dpdt
% Mechanically linked DPDT contacts: six stable terminals.
\draw[draw=dcColor0, line width=1.4226pt] (1,-0.75) -- (1.575,-0.75) (2.425,-0.25) -- (3,-0.25) (2.425,-1.25) -- (3,-1.25) (1.625,-0.75) -- (2.35,-0.25);
\draw[draw=dcColor0, line width=1.4226pt, fill=white] (1.6,-0.75) circle (1.7783pt);
\draw[draw=dcColor0, line width=1.4226pt, fill=white] (2.4,-0.25) circle (1.7783pt);
\draw[draw=dcColor0, line width=1.4226pt, fill=white] (2.4,-1.25) circle (1.7783pt);
\draw[draw=dcColor0, line width=1.4226pt] (1,-2.25) -- (1.575,-2.25) (2.425,-1.75) -- (3,-1.75) (2.425,-2.75) -- (3,-2.75) (1.625,-2.25) -- (2.35,-1.75);
\draw[draw=dcColor0, line width=1.4226pt, fill=white] (1.6,-2.25) circle (1.7783pt);
\draw[draw=dcColor0, line width=1.4226pt, fill=white] (2.4,-1.75) circle (1.7783pt);
\draw[draw=dcColor0, line width=1.4226pt, fill=white] (2.4,-2.75) circle (1.7783pt);
\draw[draw=dcColor0, line width=1.4226pt, densely dashed] (2,-0.5) -- (2,-2);
\node[text=dcColor1, anchor=center, inner sep=0pt, rotate=0, font=\fontsize{15.649}{20.3437}\selectfont] at (2,0.25) {$q_{dpdt}$};
\end{circuitikz}