% DrawCircuit — coordinates in cm; SVG Y axis inverted.
\definecolor{dcColor0}{HTML}{171A20}
\definecolor{dcColor1}{HTML}{2463CB}
\definecolor{dcColor2}{HTML}{DF4949}
\begin{circuitikz}[european resistors, american inductors, american ports, line cap=round, line join=round]
\ctikzset{bipoles/length=1.4cm}
\draw[draw=dcColor0, line width=1.4226pt] (-5,-0.5) -- (-4,-0.5) -- (-3,-0.5);
\draw[draw=dcColor0, line width=1.4226pt] (5,-0.5) -- (7,-0.5);
\draw[draw=dcColor0, line width=1.4226pt] (-3,1.5) -- (-3,-0.5);
\draw[draw=dcColor0, line width=1.4226pt] (5,1.5) -- (5,-0.5);
\draw[draw=dcColor0, line width=1.4226pt] (-3,-0.5) -- (-3,-2.5);
\draw[draw=dcColor0, line width=1.4226pt] (5,-0.5) -- (5,-2.5);
\draw[draw=dcColor0, line width=1.4226pt] (-3,1.5) -- (0,1.5);
\draw[draw=dcColor0, line width=1.4226pt] (2,1.5) -- (5,1.5);
\draw[draw=dcColor0, line width=1.4226pt] (-3,-2.5) -- (0,-2.5);
\draw[draw=dcColor0, line width=1.4226pt] (2,-2.5) -- (5,-2.5);
% Component: resistor
\draw[draw=dcColor0, line width=1.4226pt] (0,1.5) to[R, fill=white, name=dcComponent0] (2,1.5);
% Component: inductor
\draw[draw=dcColor0, line width=1.4226pt] (0,-2.5) to[L, fill=white, name=dcComponent1] (2,-2.5);
\fill[dcColor0] (-5,-0.5) circle (3.2009pt);
\fill[dcColor0] (7,-0.5) circle (3.2009pt);
\fill[dcColor0] (-3,1.5) circle (3.2009pt);
\fill[dcColor0] (5,1.5) circle (3.2009pt);
\fill[dcColor0] (-3,-0.5) circle (3.2009pt);
\fill[dcColor0] (5,-0.5) circle (3.2009pt);
\fill[dcColor0] (-3,-2.5) circle (3.2009pt);
\fill[dcColor0] (5,-2.5) circle (3.2009pt);
\node[text=dcColor1, anchor=center, inner sep=0pt, rotate=0, font=\fontsize{15.649}{20.3437}\selectfont] at (1,2.25) {$R_1$};
\node[text=dcColor1, anchor=center, inner sep=0pt, rotate=0, font=\fontsize{15.649}{20.3437}\selectfont] at (1,-1.75) {$L_1$};
\node[text=dcColor2, anchor=center, inner sep=0pt, rotate=0, font=\fontsize{17.0717}{22.1931}\selectfont] at (-5.5,0.5) {A};
\node[text=dcColor2, anchor=center, inner sep=0pt, rotate=0, font=\fontsize{17.0717}{22.1931}\selectfont] at (7.5,0.5) {B};
\end{circuitikz}