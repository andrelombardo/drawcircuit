% DrawCircuit — coordinates in cm; SVG Y axis inverted.
\definecolor{dcColor0}{HTML}{171A20}
\definecolor{dcColor1}{HTML}{2463CB}
\definecolor{dcColor2}{HTML}{DF4949}
\begin{circuitikz}[european resistors, american inductors, american ports, line cap=round, line join=round]
\ctikzset{bipoles/length=1.4cm}
\draw[draw=dcColor0, line width=1.4226pt] (-4,0) -- (-6,0);
\draw[draw=dcColor0, line width=1.4226pt] (-2,0) -- (0,0);
\draw[draw=dcColor0, line width=1.4226pt] (2,0) -- (0,0);
\draw[draw=dcColor0, line width=1.4226pt] (4,0) -- (6,0);
\draw[draw=dcColor0, line width=1.4226pt] (-6,-2) -- (-6,0);
\draw[draw=dcColor0, line width=1.4226pt] (-6,-4) -- (-6,-5.5) -- (0,-5.5);
\draw[draw=dcColor0, line width=1.4226pt] (0,-2) -- (0,0);
\draw[draw=dcColor0, line width=1.4226pt] (0,-4) -- (0,-5.5);
\draw[draw=dcColor0, line width=1.4226pt] (6,-2) -- (6,0);
\draw[draw=dcColor0, line width=1.4226pt] (6,-4) -- (6,-5.5) -- (0,-5.5);
\draw[draw=dcColor0, line width=1.4226pt] (-1,4) -- (-6,4) -- (-6,0);
\draw[draw=dcColor0, line width=1.4226pt] (1,4) -- (6,4) -- (6,0);
% Component: resistor
\draw[draw=dcColor0, line width=1.4226pt] (-4,0) to[R, fill=white, name=dcComponent0] (-2,0);
% Component: resistor
\draw[draw=dcColor0, line width=1.4226pt] (2,0) to[R, fill=white, name=dcComponent1] (4,0);
% Component: resistor
\draw[draw=dcColor0, line width=1.4226pt] (-1,4) to[R, fill=white, name=dcComponent2] (1,4);
% Component: resistor
\draw[draw=dcColor0, line width=1.4226pt] (-6,-2) to[R, fill=white, name=dcComponent3] (-6,-4);
% Component: resistor
\draw[draw=dcColor0, line width=1.4226pt] (0,-2) to[R, fill=white, name=dcComponent4] (0,-4);
% Component: resistor
\draw[draw=dcColor0, line width=1.4226pt] (6,-2) to[R, fill=white, name=dcComponent5] (6,-4);
% Component: resistor
\draw[draw=dcColor0, line width=1.4226pt] (3,-3) to[R, fill=white, name=dcComponent6] (5,-3);
\fill[dcColor0] (-6,0) circle (3.2009pt);
\fill[dcColor0] (0,0) circle (3.2009pt);
\fill[dcColor0] (6,0) circle (3.2009pt);
\fill[dcColor0] (0,-5.5) circle (3.2009pt);
\node[text=dcColor1, anchor=center, inner sep=0pt, rotate=0, font=\fontsize{16.3603}{21.2684}\selectfont] at (-3,0.75) {$r_{AB}$};
\node[text=dcColor1, anchor=center, inner sep=0pt, rotate=0, font=\fontsize{16.3603}{21.2684}\selectfont] at (3,0.75) {$r_{BC}$};
\node[text=dcColor1, anchor=center, inner sep=0pt, rotate=0, font=\fontsize{16.3603}{21.2684}\selectfont] at (0,4.75) {$r_{AC}$};
\node[text=dcColor1, anchor=center, inner sep=0pt, rotate=0, font=\fontsize{16.3603}{21.2684}\selectfont] at (-7.1,-3) {$r_{AD}$};
\node[text=dcColor1, anchor=center, inner sep=0pt, rotate=0, font=\fontsize{16.3603}{21.2684}\selectfont] at (1.1,-3) {$r_{BD}$};
\node[text=dcColor1, anchor=center, inner sep=0pt, rotate=0, font=\fontsize{16.3603}{21.2684}\selectfont] at (7.1,-3) {$r_{CD}$};
\node[text=dcColor1, anchor=center, inner sep=0pt, rotate=0, font=\fontsize{15.649}{20.3437}\selectfont] at (4,-2.25) {$R_1$};
\node[text=dcColor2, anchor=center, inner sep=0pt, rotate=0, font=\fontsize{19.2056}{24.9673}\selectfont] at (-6.65,-0.125) {A};
\node[text=dcColor2, anchor=center, inner sep=0pt, rotate=0, font=\fontsize{19.2056}{24.9673}\selectfont] at (0,0.75) {B};
\node[text=dcColor2, anchor=center, inner sep=0pt, rotate=0, font=\fontsize{19.2056}{24.9673}\selectfont] at (6.65,-0.125) {C};
\node[text=dcColor2, anchor=center, inner sep=0pt, rotate=0, font=\fontsize{19.2056}{24.9673}\selectfont] at (0,-6.35) {D};
\draw[->, draw=dcColor2, line width=1.2804pt] (-1.95,-0.8813) arc[start angle=60, end angle=-250, radius=2.1cm];
\node[text=dcColor2, anchor=center, inner sep=0pt, rotate=0, font=\fontsize{14.2264}{18.4943}\selectfont] at (-3,-2.925) {maglia 1};
\draw[->, draw=dcColor2, line width=1.2804pt] (-4.25,1.5) .. controls (-3.875,2.075) and (-2,2.075) .. (-1.625,1.5);
\node[text=dcColor2, anchor=center, inner sep=0pt, rotate=0, font=\fontsize{16.3603}{21.2684}\selectfont] at (-3,2.5) {$i_1$};
\end{circuitikz}