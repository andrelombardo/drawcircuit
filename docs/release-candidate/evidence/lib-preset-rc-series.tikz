% DrawCircuit — coordinates in cm; SVG Y axis inverted.
\definecolor{dcColor0}{HTML}{171A20}
\definecolor{dcColor1}{HTML}{2463CB}
\definecolor{dcColor2}{HTML}{DF4949}
\begin{circuitikz}[european resistors, american inductors, american ports, line cap=round, line join=round]
\ctikzset{bipoles/length=1.4cm}
\draw[draw=dcColor0, line width=1.4226pt] (-3,-0.5) -- (-2,-0.5) -- (-2,-1.5) -- (-2,-0.5);
\draw[draw=dcColor0, line width=1.4226pt] (0,-0.5) -- (2,-0.5);
\draw[draw=dcColor0, line width=1.4226pt] (4,-0.5) -- (5,-0.5);
% Component: resistor
\draw[draw=dcColor0, line width=1.4226pt] (-2,-0.5) to[R, fill=white, name=dcComponent0] (0,-0.5);
% Component: capacitor
\draw[draw=dcColor0, line width=1.4226pt] (2,-0.5) to[C, fill=white, name=dcComponent1] (4,-0.5);
\fill[dcColor0] (-3,-0.5) circle (3.2009pt);
\fill[dcColor0] (5,-0.5) circle (3.2009pt);
\node[text=dcColor1, anchor=center, inner sep=0pt, rotate=0, font=\fontsize{15.649}{20.3437}\selectfont] at (-1,0.25) {$R_1$};
\node[text=dcColor1, anchor=center, inner sep=0pt, rotate=0, font=\fontsize{15.649}{20.3437}\selectfont] at (3,0.25) {$C_1$};
\node[text=dcColor2, anchor=center, inner sep=0pt, rotate=0, font=\fontsize{17.0717}{22.1931}\selectfont] at (-3,0.1) {A};
\node[text=dcColor2, anchor=center, inner sep=0pt, rotate=0, font=\fontsize{17.0717}{22.1931}\selectfont] at (5,0.1) {B};
\end{circuitikz}