% DrawCircuit — coordinates in cm; SVG Y axis inverted.
\definecolor{dcColor0}{HTML}{171A20}
\definecolor{dcColor1}{HTML}{2463CB}
\begin{circuitikz}[european resistors, american inductors, american ports, line cap=round, line join=round]
\ctikzset{bipoles/length=1.4cm}
\draw[draw=dcColor0, line width=1.4226pt] (1,-0.5) -- (-1,-0.5) -- (-1,3) -- (-3.5,3);
\draw[draw=dcColor0, line width=1.4226pt] (1,-2.5) -- (-1,-2.5) -- (-1,2) -- (-3.5,2);
\draw[draw=dcColor0, line width=1.4226pt] (3,-0.5) -- (4.5,-0.5) -- (4.5,1) -- (6,1);
\draw[draw=dcColor0, line width=1.4226pt] (3,-2.5) -- (4.5,-2.5) -- (4.5,0) -- (6,0);
% Component: coupledInductors
\node[transformer, draw=dcColor0, line width=1.4226pt, fill=white, rotate=0, scale=0.65, transform shape] (dcComponent0) at (2,-1.5) {};
\draw[draw=dcColor0, line width=1.4226pt] (1,-0.5) -- (dcComponent0.A1);
\draw[draw=dcColor0, line width=1.4226pt] (1,-2.5) -- (dcComponent0.A2);
\draw[draw=dcColor0, line width=1.4226pt] (3,-0.5) -- (dcComponent0.B1);
\draw[draw=dcColor0, line width=1.4226pt] (3,-2.5) -- (dcComponent0.B2);
\node[text=dcColor1, anchor=center, inner sep=0pt, rotate=0, font=\fontsize{15.649}{20.3437}\selectfont] at (2,0) {$q_{coupledInductors}$};
\end{circuitikz}