% DrawCircuit — coordinates in cm; SVG Y axis inverted.
\definecolor{dcColor0}{HTML}{171A20}
\definecolor{dcColor1}{HTML}{2463CB}
\definecolor{dcColor2}{HTML}{DF4949}
\begin{circuitikz}[european resistors, american inductors, american ports, line cap=round, line join=round]
\ctikzset{bipoles/length=1.4cm}
\draw[draw=dcColor0, line width=1.4226pt] (1,4.5) -- (1.5,4.5) -- (1.5,3) -- (1,3) -- (1,3.5);
\draw[draw=dcColor0, line width=1.4226pt] (1,1.5) -- (1,-0.5);
\draw[draw=dcColor0, line width=1.4226pt] (1,-0.5) -- (-1,-0.5) -- (-1,-2.5);
\draw[draw=dcColor0, line width=1.4226pt] (-3,-2.5) -- (-4,-2.5);
\draw[draw=dcColor0, line width=1.4226pt] (1,-0.5) -- (3,-0.5) -- (3,-2.5);
\draw[draw=dcColor0, line width=1.4226pt] (5,-2.5) -- (6,-2.5);
% Component: resistor
\draw[draw=dcColor0, line width=1.4226pt] (1,3.5) to[R, fill=white, name=dcComponent0] (1,1.5);
% Component: resistor
\draw[draw=dcColor0, line width=1.4226pt] (-3,-2.5) to[R, fill=white, name=dcComponent1] (-1,-2.5);
% Component: resistor
\draw[draw=dcColor0, line width=1.4226pt] (3,-2.5) to[R, fill=white, name=dcComponent2] (5,-2.5);
\fill[dcColor0] (1,4.5) circle (3.2009pt);
\fill[dcColor0] (-4,-2.5) circle (3.2009pt);
\fill[dcColor0] (6,-2.5) circle (3.2009pt);
\fill[dcColor0] (1,-0.5) circle (3.2009pt);
\node[text=dcColor1, anchor=center, inner sep=0pt, rotate=0, font=\fontsize{15.649}{20.3437}\selectfont] at (2,2.5) {$R_1$};
\node[text=dcColor1, anchor=center, inner sep=0pt, rotate=0, font=\fontsize{15.649}{20.3437}\selectfont] at (-2,-1.75) {$R_2$};
\node[text=dcColor1, anchor=center, inner sep=0pt, rotate=0, font=\fontsize{15.649}{20.3437}\selectfont] at (4,-1.75) {$R_3$};
\node[text=dcColor2, anchor=center, inner sep=0pt, rotate=0, font=\fontsize{17.0717}{22.1931}\selectfont] at (1,5.1) {A};
\node[text=dcColor2, anchor=center, inner sep=0pt, rotate=0, font=\fontsize{17.0717}{22.1931}\selectfont] at (-4.5,-3.5) {B};
\node[text=dcColor2, anchor=center, inner sep=0pt, rotate=0, font=\fontsize{17.0717}{22.1931}\selectfont] at (6.5,-3.5) {C};
\node[text=dcColor2, anchor=center, inner sep=0pt, rotate=0, font=\fontsize{17.0717}{22.1931}\selectfont] at (2,0.5) {N};
\end{circuitikz}