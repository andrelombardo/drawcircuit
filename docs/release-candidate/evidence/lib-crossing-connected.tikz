% DrawCircuit — coordinates in cm; SVG Y axis inverted.
\definecolor{dcColor0}{HTML}{171A20}
\definecolor{dcColor1}{HTML}{DF4949}
\begin{circuitikz}[european resistors, american inductors, american ports, line cap=round, line join=round]
\ctikzset{bipoles/length=1.4cm}
\draw[draw=dcColor0, line width=1.4226pt] (-4,0) -- (0,0);
\draw[draw=dcColor0, line width=1.4226pt] (0,0) -- (4,0);
\draw[draw=dcColor0, line width=1.4226pt] (0,3) -- (0,0);
\draw[draw=dcColor0, line width=1.4226pt] (0,0) -- (0,-3);
\fill[dcColor0] (0,0) circle (3.2009pt);
\node[text=dcColor1, anchor=center, inner sep=0pt, rotate=0, font=\fontsize{17.0717}{22.1931}\selectfont] at (0,0.6) {A};
\end{circuitikz}