% DrawCircuit — coordinates in cm; SVG Y axis inverted.
\definecolor{dcColor0}{HTML}{171A20}
\definecolor{dcColor1}{HTML}{2463CB}
\definecolor{dcColor2}{HTML}{DF4949}
\begin{circuitikz}[european resistors, american inductors, american ports, line cap=round, line join=round]
\ctikzset{bipoles/length=1.4cm}
\draw[draw=dcColor0, line width=1.4226pt] (-6.5,1) -- (-8,1);
\draw[draw=dcColor0, line width=1.4226pt] (-5,2) -- (-5,4);
\draw[draw=dcColor0, line width=1.4226pt] (-5,0) -- (-5,-2);
\draw[draw=dcColor0, line width=1.4226pt] (2.5,1.5) -- (0.5,1.5);
\draw[draw=dcColor0, line width=1.4226pt] (2.5,0.5) -- (0.5,0.5);
\draw[draw=dcColor0, line width=1.4226pt] (4.5,1) -- (6.5,1);
\draw[draw=dcColor0, line width=1.4226pt] (-2,-3) -- (3,-3);
\draw[draw=dcColor0, line width=1.4226pt] (0.5,-1.5) -- (0.5,-5);
% Unconnected wire crossing: horizontal bridge
\draw[draw=white,line width=4.2679pt] (0.325,-3) -- (0.675,-3);
\draw[draw=dcColor0,line width=1.4226pt] (0.5,-2.825) -- (0.5,-3.175);
\draw[draw=white,line width=4.2679pt] (0.325,-3) .. controls (0.395,-2.825) and (0.605,-2.825) .. (0.675,-3);
\draw[draw=dcColor0,line width=1.4226pt] (0.325,-3) .. controls (0.395,-2.825) and (0.605,-2.825) .. (0.675,-3);
% Component: npn
\node[npn, draw=dcColor0, line width=1.4226pt, fill=white, rotate=0, scale=0.7, transform shape] (dcComponent0) at (-5.5,1) {};
\draw[draw=dcColor0, line width=1.4226pt] (-6.5,1) -- (dcComponent0.B);
\draw[draw=dcColor0, line width=1.4226pt] (-5,2) -- (dcComponent0.C);
\draw[draw=dcColor0, line width=1.4226pt] (-5,0) -- (dcComponent0.E);
% Component: opAmp
\node[op amp, draw=dcColor0, line width=1.4226pt, fill=white, rotate=0, scale=0.6, transform shape] (dcComponent1) at (3.5,1) {};
\draw[draw=dcColor0, line width=1.4226pt] (2.5,1.5) -- (dcComponent1.-);
\draw[draw=dcColor0, line width=1.4226pt] (2.5,0.5) -- (dcComponent1.+);
\draw[draw=dcColor0, line width=1.4226pt] (4.5,1) -- (dcComponent1.out);
\node[text=dcColor1, anchor=center, inner sep=0pt, rotate=0, font=\fontsize{15.649}{20.3437}\selectfont] at (-5.5,2.5) {$Q_1$};
\node[text=dcColor1, anchor=center, inner sep=0pt, rotate=0, font=\fontsize{15.649}{20.3437}\selectfont] at (3.5,2.2) {$U_1$};
% Electrical annotation: current
\draw[draw=dcColor2,line width=1.4226pt] (-6.5,0.6) -- (-8,0.6);
\draw[draw=dcColor2,line width=1.4226pt] (-7.8,0.6875) -- (-8,0.6) -- (-7.8,0.5125);
\node[text=dcColor1, anchor=center, inner sep=0pt, rotate=0, font=\fontsize{15.649}{20.3437}\selectfont] at (-7.25,0) {$i_1$};
% Electrical annotation: voltage
\draw[draw=dcColor2,line width=1.4226pt] (-2.5,3.5) -- (1.5,3.5);
\draw[draw=dcColor2,line width=1.4226pt] (1.3,3.4125) -- (1.5,3.5) -- (1.3,3.5875);
\node[text=dcColor1, anchor=center, inner sep=0pt, rotate=0, font=\fontsize{15.649}{20.3437}\selectfont] at (-0.5,4.1) {$V_{AB}$};
\draw[->, draw=dcColor2, line width=1.4226pt] (2.9692,-2.6871) arc[start angle=369, end angle=45, x radius=2.5cm, y radius=2cm];
\end{circuitikz}