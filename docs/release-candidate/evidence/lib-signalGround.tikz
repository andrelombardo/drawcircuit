% DrawCircuit — coordinates in cm; SVG Y axis inverted.
\definecolor{dcColor0}{HTML}{171A20}
\definecolor{dcColor1}{HTML}{2463CB}
\begin{circuitikz}[european resistors, american inductors, american ports, line cap=round, line join=round]
\ctikzset{bipoles/length=1.4cm}
\draw[draw=dcColor0, line width=1.4226pt] (2,-0.5) -- (2,3) -- (6,3);
% Component: signalGround
\draw[draw=dcColor0, line width=1.4226pt] (2,-0.5) -- (2,-1.5) node[sground, rotate=0, fill=white] {};
\node[text=dcColor1, anchor=center, inner sep=0pt, rotate=0, font=\fontsize{15.649}{20.3437}\selectfont] at (2,0) {$q_{signalGround}$};
\end{circuitikz}