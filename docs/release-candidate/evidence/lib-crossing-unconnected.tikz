% DrawCircuit — coordinates in cm; SVG Y axis inverted.
\definecolor{dcColor0}{HTML}{171A20}
\begin{circuitikz}[european resistors, american inductors, american ports, line cap=round, line join=round]
\ctikzset{bipoles/length=1.4cm}
\draw[draw=dcColor0, line width=1.4226pt] (-4,0) -- (4,0);
\draw[draw=dcColor0, line width=1.4226pt] (0,3) -- (0,-3);
% Unconnected wire crossing: horizontal bridge
\draw[draw=white,line width=4.2679pt] (-0.175,0) -- (0.175,0);
\draw[draw=dcColor0,line width=1.4226pt] (0,0.175) -- (0,-0.175);
\draw[draw=white,line width=4.2679pt] (-0.175,0) .. controls (-0.105,0.175) and (0.105,0.175) .. (0.175,0);
\draw[draw=dcColor0,line width=1.4226pt] (-0.175,0) .. controls (-0.105,0.175) and (0.105,0.175) .. (0.175,0);
\end{circuitikz}