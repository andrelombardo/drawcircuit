% DrawCircuit — coordinates in cm; SVG Y axis inverted.
\definecolor{dcColor0}{HTML}{171A20}
\definecolor{dcColor1}{HTML}{2463CB}
\begin{circuitikz}[european resistors, american inductors, american ports, line cap=round, line join=round]
\ctikzset{bipoles/length=1.4cm}
\draw[draw=dcColor0, line width=1.4226pt] (1,-1.5) -- (-1,-1.5) -- (-1,3) -- (-3.5,3);
\draw[draw=dcColor0, line width=1.4226pt] (3,-1.5) -- (4.5,-1.5) -- (4.5,2) -- (6,2);
% Component: varactor
\draw[draw=dcColor0, line width=1.4226pt] (1,-1.5) to[VC, fill=white, name=dcComponent0] (3,-1.5);
\node[text=dcColor1, anchor=center, inner sep=0pt, rotate=0, font=\fontsize{15.649}{20.3437}\selectfont] at (2,-0.3) {$q_{varactor}$};
\end{circuitikz}