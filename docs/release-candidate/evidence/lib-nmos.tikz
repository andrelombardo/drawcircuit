% DrawCircuit — coordinates in cm; SVG Y axis inverted.
\definecolor{dcColor0}{HTML}{171A20}
\definecolor{dcColor1}{HTML}{2463CB}
\begin{circuitikz}[european resistors, american inductors, american ports, line cap=round, line join=round]
\ctikzset{bipoles/length=1.4cm}
\draw[draw=dcColor0, line width=1.4226pt] (1,-1.5) -- (-1,-1.5) -- (-1,3) -- (-3.5,3);
\draw[draw=dcColor0, line width=1.4226pt] (2.5,-0.5) -- (2.5,2) -- (6,2);
\draw[draw=dcColor0, line width=1.4226pt] (2.5,-2.5) -- (2.5,1) -- (6,1);
% Component: nmos
\node[nmos, draw=dcColor0, line width=1.4226pt, fill=white, rotate=0, scale=0.7, transform shape] (dcComponent0) at (2,-1.5) {};
\draw[draw=dcColor0, line width=1.4226pt] (1,-1.5) -- (dcComponent0.G);
\draw[draw=dcColor0, line width=1.4226pt] (2.5,-0.5) -- (dcComponent0.D);
\draw[draw=dcColor0, line width=1.4226pt] (2.5,-2.5) -- (dcComponent0.S);
\node[text=dcColor1, anchor=center, inner sep=0pt, rotate=0, font=\fontsize{15.649}{20.3437}\selectfont] at (2,0) {$q_{nmos}$};
\end{circuitikz}