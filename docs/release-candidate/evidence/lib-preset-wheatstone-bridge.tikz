% DrawCircuit — coordinates in cm; SVG Y axis inverted.
\definecolor{dcColor0}{HTML}{171A20}
\definecolor{dcColor1}{HTML}{2463CB}
\definecolor{dcColor2}{HTML}{DF4949}
\begin{circuitikz}[european resistors, american inductors, american ports, line cap=round, line join=round]
\ctikzset{bipoles/length=1.4cm}
\draw[draw=dcColor0, line width=1.4226pt] (1,4.5) -- (-0.5,4.5) -- (-0.5,3.5) -- (-3,3.5) -- (-3,4.5) -- (-3,3);
\draw[draw=dcColor0, line width=1.4226pt] (-3,1) -- (-3,-0.5);
\draw[draw=dcColor0, line width=1.4226pt] (1,4.5) -- (5,4.5) -- (5,3);
\draw[draw=dcColor0, line width=1.4226pt] (5,1) -- (5,-0.5);
\draw[draw=dcColor0, line width=1.4226pt] (-3,-0.5) -- (-3,-2);
\draw[draw=dcColor0, line width=1.4226pt] (-3,-4) -- (-3,-5.5) -- (1,-5.5);
\draw[draw=dcColor0, line width=1.4226pt] (5,-0.5) -- (5,-2);
\draw[draw=dcColor0, line width=1.4226pt] (5,-4) -- (5,-5.5) -- (1,-5.5);
\draw[draw=dcColor0, line width=1.4226pt] (-3,-0.5) -- (0,-0.5);
\draw[draw=dcColor0, line width=1.4226pt] (2,-0.5) -- (5,-0.5);
% Component: resistor
\draw[draw=dcColor0, line width=1.4226pt] (-3,3) to[R, fill=white, name=dcComponent0] (-3,1);
% Component: resistor
\draw[draw=dcColor0, line width=1.4226pt] (5,3) to[R, fill=white, name=dcComponent1] (5,1);
% Component: resistor
\draw[draw=dcColor0, line width=1.4226pt] (-3,-2) to[R, fill=white, name=dcComponent2] (-3,-4);
% Component: resistor
\draw[draw=dcColor0, line width=1.4226pt] (5,-2) to[R, fill=white, name=dcComponent3] (5,-4);
% Component: resistor
\draw[draw=dcColor0, line width=1.4226pt] (0,-0.5) to[R, fill=white, name=dcComponent4] (2,-0.5);
\fill[dcColor0] (1,4.5) circle (3.2009pt);
\fill[dcColor0] (-3,-0.5) circle (3.2009pt);
\fill[dcColor0] (5,-0.5) circle (3.2009pt);
\fill[dcColor0] (1,-5.5) circle (3.2009pt);
\node[text=dcColor1, anchor=center, inner sep=0pt, rotate=0, font=\fontsize{15.649}{20.3437}\selectfont] at (-4,2) {$R_1$};
\node[text=dcColor1, anchor=center, inner sep=0pt, rotate=0, font=\fontsize{15.649}{20.3437}\selectfont] at (6,2) {$R_2$};
\node[text=dcColor1, anchor=center, inner sep=0pt, rotate=0, font=\fontsize{15.649}{20.3437}\selectfont] at (-4,-3) {$R_3$};
\node[text=dcColor1, anchor=center, inner sep=0pt, rotate=0, font=\fontsize{15.649}{20.3437}\selectfont] at (6,-3) {$R_4$};
\node[text=dcColor1, anchor=center, inner sep=0pt, rotate=0, font=\fontsize{15.649}{20.3437}\selectfont] at (1,0.25) {$R_5$};
\node[text=dcColor2, anchor=center, inner sep=0pt, rotate=0, font=\fontsize{17.0717}{22.1931}\selectfont] at (1,5.1) {A};
\node[text=dcColor2, anchor=center, inner sep=0pt, rotate=0, font=\fontsize{17.0717}{22.1931}\selectfont] at (-4,-0.5) {B};
\node[text=dcColor2, anchor=center, inner sep=0pt, rotate=0, font=\fontsize{17.0717}{22.1931}\selectfont] at (6,-0.5) {C};
\node[text=dcColor2, anchor=center, inner sep=0pt, rotate=0, font=\fontsize{17.0717}{22.1931}\selectfont] at (1,-6.5) {D};
\end{circuitikz}