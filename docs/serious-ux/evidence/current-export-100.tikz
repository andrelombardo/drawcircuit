% DrawCircuit — coordinates in cm; SVG Y axis inverted.
\definecolor{dcColor0}{HTML}{171717}
\definecolor{dcColor1}{HTML}{171A20}
\definecolor{dcColor2}{HTML}{DF4949}
\definecolor{dcColor3}{HTML}{E32636}
\definecolor{dcColor4}{HTML}{2463CB}
\begin{circuitikz}[european resistors, american inductors, american ports, line cap=round, line join=round]
\ctikzset{bipoles/length=1.4cm}
\draw[draw=dcColor0, line width=1.4226pt] (-5.5,0) -- (-0.45,0);
\draw[draw=dcColor0, line width=1.4226pt] (0.45,0) -- (5.5,0);
\fill[dcColor1] (-5.5,0) circle (3.2009pt);
\fill[dcColor1] (5.5,0) circle (3.2009pt);
\node[text=dcColor2, anchor=center, inner sep=0pt, rotate=0, font=\fontsize{17.0717}{22.1931}\selectfont] at (-5.5,0.6) {A};
\node[text=dcColor2, anchor=center, inner sep=0pt, rotate=0, font=\fontsize{17.0717}{22.1931}\selectfont] at (5.5,0.6) {B};
% Electrical annotation: current
\draw[draw=dcColor3,line width=1.4226pt,line cap=round,line join=round] (-0.45,0) -- (0.45,0);
\draw[draw=dcColor3,line width=1.4226pt,line cap=round,line join=round] (0.2,-0.1125) -- (0.45,0) -- (0.2,0.1125);
\node[text=dcColor4, anchor=center, inner sep=0pt, rotate=0, font=\fontsize{15.649}{20.3437}\selectfont] at (0,-0.6) {$i_1$};
\end{circuitikz}